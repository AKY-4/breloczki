<section id="projekty" class="sekcja" aria-labelledby="projekty-h">
  <%= deko "gwiazdka", "#ff6fa8", "dk-prawa-gwiazdka" %>
  <div class="kontener">
    <h2 id="projekty-h" class="tytul-sekcji"><span class="kropka kropka--pomarancz"></span>Przykładowe projekty breloków i tabliczek</h2>
    <p class="lead">Tak wyglądają projekty przygotowane dla lokalnych firm z różnych branż. Każdy ma inny kształt i kolory, bo powstaje z logo konkretnej firmy.</p>
    <ul class="galeria">
<% galeria.each do |g| -%>
      <li class="kafel<%= " kafel--zdjecie" if g["typ"] == "zdjecie" %>">
        <figure>
          <div class="kafel__obraz" style="background-color:<%= h g["tlo"] %>">
            <picture>
              <source type="image/avif" srcset="<%= zasob("img/projekty/#{g["plik"]}.avif") %>">
              <img src="<%= zasob("img/projekty/#{g["plik"]}.jpg") %>" width="<%= g["w"] %>" height="<%= g["h"] %>" alt="<%= h g["alt"] %>" loading="lazy" decoding="async">
            </picture>
          </div>
          <figcaption>
            <span class="kafel__podpis"><%= h g["podpis"] %></span>
            <span class="kafel__etykieta"><%= g["typ"] == "zdjecie" ? "realizacja" : "wizualizacja projektu" %></span>
<% if podglad? && !g["zgoda"] -%>
            <span class="kafel__czeka">czeka na zgodę firmy: <%= h g["firma"] %></span>
<% end -%>
          </figcaption>
        </figure>
      </li>
<% end -%>
    </ul>
  </div>
</section>
