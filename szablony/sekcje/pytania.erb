<section id="pytania" class="sekcja" aria-labelledby="pytania-h">
  <%= deko "kropki", "#43d1a6", "dk-lewa-kropki" %>
  <div class="kontener">
    <h2 id="pytania-h" class="tytul-sekcji"><span class="kropka kropka--mieta"></span>Najczęstsze pytania o breloki z logo i tabliczki NFC</h2>
    <div class="pytania-uklad<%= " pytania-uklad--z-nagraniem" if nagranie %>">
      <div class="pytania">
<% faq_opublikowane.each_with_index do |f, i| -%>
        <details class="pytanie"<%= " open" if i == 0 %>>
          <summary><h3><%= h f["pytanie"] %></h3><span class="pytanie__znak" aria-hidden="true"></span></summary>
          <p><%= h f["odpowiedz"] %></p>
        </details>
<% end -%>
      </div>
<% if nagranie -%>
      <aside class="nagranie karta" aria-label="Nagranie z druku breloków">
        <video class="nagranie__film" muted loop playsinline controls preload="none" width="464" height="832" poster="<%= zasob("wideo/#{nagranie["plakat"]}") %>" aria-label="<%= h nagranie["etykieta"] %>" data-nagranie>
          <source src="<%= zasob("wideo/#{nagranie["plik"]}") %>" type="video/mp4">
        </video>
        <div class="nagranie__tekst">
          <h3><%= h nagranie["tytul"] %></h3>
          <p><%= h nagranie["opis"] %></p>
        </div>
      </aside>
<% end -%>
    </div>
<% if podglad? && !faq_czekajace.empty? -%>
    <div class="czeka-na-dane">
      <p><strong>Widoczne tylko w podglądzie.</strong> Te pytania czekają na dane od właściciela i nie trafią do wersji do publikacji, dopóki nie dostaną odpowiedzi w pliku dane.yml:</p>
      <ul>
<% faq_czekajace.each do |f| -%>
        <li><%= h f["pytanie"] %> <span>(czeka na: <%= h f["czeka_na"] %>)</span></li>
<% end -%>
      </ul>
    </div>
<% end -%>
  </div>
</section>
